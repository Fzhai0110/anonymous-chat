{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anonymous-chat-3",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-07",
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  "durable_objects": { "bindings": [{ "name": "CHAT_ROOM", "class_name": "ChatRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }],
  "d1_databases": [{ "binding": "CHAT_DB", "database_name": "anonymous-chat-db", "database_id": "3d9baa8e-6dbd-48a3-8365-5d493aa464e3" }],

